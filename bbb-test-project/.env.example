# ── Local (non-Docker) dev ────────────────────────────────────────────────
PORT=3000

# Run against the built-in mock (default) …
BBB_MOCK=true
BBB_URL=http://localhost:3000/bbb-mock/api
BBB_SECRET=devsecret

# … or point at a REAL BigBlueButton server:
# BBB_MOCK=false
# BBB_URL=https://your-bbb-host/bigbluebutton/api
# BBB_SECRET=<shared secret from `bbb-conf --secret` on the BBB host>
